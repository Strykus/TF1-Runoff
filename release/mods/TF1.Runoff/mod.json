{
  "Name": "TF1.Runoff",
  "Version": "0.3.3",
  "LoadPriority": 200,
  "RequiredOnClient": true,
  "Description": "TF1 Runoff: native map, repaired Titan navigation, modes, lighting, water, effects and menu artwork.",
  "Scripts": [
    {
      "Path": "tf1_runoff_register.nut",
      "RunOn": "UI || MP",
      "UICallback": {
        "After": "TF1_Runoff_Register"
      },
      "ClientCallback": {
        "After": "TF1_Runoff_Register"
      },
      "ServerCallback": {
        "After": "TF1_Runoff_Register"
      }
    },
    {
      "Path": "cl_tf1_runoff_atmosphere.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "TF1_Runoff_Atmosphere_ClientInit"
      }
    },
    {
      "Path": "sv_tf1_runoff_atmosphere.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "After": "TF1_Runoff_Atmosphere_ServerInit"
      }
    },
    {
      "Path": "ui_runoff_connect.nut",
      "RunOn": "UI",
      "UICallback": {
        "After": "RunoffClientConnect_Init"
      }
    },
    {
      "Path": "cl_runoff_tube_effects.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "RunoffTubeEffects_Init"
      }
    },
    {
      "Path": "cl_runoff_minimap.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "RunoffMinimap_Init"
      }
    },
    {
      "Path": "cl_pipe_playback.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "RunoffPipePlayback_ClientInit"
      }
    },
    {
      "Path": "sv_runoff_safe_titanfall.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "After": "RunoffSafeTitanfall_Init"
      }
    },
    {
      "Path": "cl_runoff_soft_lighting.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "RunoffSoftLighting_Init",
        "Destroy": "RunoffSoftLighting_Shutdown"
      }
    },
    {
      "Path": "cl_runoff_ground_fog.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "RunoffGroundFog_Init"
      }
    },
    {
      "Path": "sh_runoff_reapers.gnut",
      "RunOn": "SERVER || CLIENT"
    },
    {
      "Path": "sv_runoff_reapers.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "After": "RunoffReapers_Init"
      }
    }
  ],
  "ConVars": [
    {
      "Name": "runoff_server_address",
      "DefaultValue": "127.0.0.1:37042"
    },
    {
      "Name": "runoff_reapers_enabled",
      "DefaultValue": "0",
      "Flags": "REPLICATED"
    }
  ],
  "Localisation": [
    "resource/tf1_runoff_names_%language%.txt"
  ]
}
