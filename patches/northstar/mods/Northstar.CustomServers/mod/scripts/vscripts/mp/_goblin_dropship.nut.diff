+void function RunoffBuildDropshipSpawns()
+{
+ wait 3
+ {}
+ array<entity> points=SpawnPoints_GetDropPod()
+ foreach(entity point in points)
+ {
+  bool found=false
+  foreach(string anim in GetRandomDropshipDropoffAnims())
+  {
+   FlightPath flightPath=GetAnalysisForModel(DROPSHIP_MODEL,anim)
+   vector origin=point.GetOrigin()+GetAnalysisOffset(flightPath)
+   for(int turn=0;turn<8;turn++)
+   {
+    float yaw=FixYaw(point.GetAngles().y+turn*45)
+    vector candidate=origin
+    if(AnalysisHasPrepSpawnpointFunc(flightPath))
+    {
+     var prepared=RunAnalysisPrepFunc(flightPath,candidate,yaw)
+     if(prepared!=null)candidate=expect vector(prepared)
+    }
+    table<string,table<string,NodeFP> > nodes=DropshipFindDropNodes(flightPath,candidate,yaw,"both",false,IsLegalFlightPath_OverTime,true)
+    if(nodes.len()!=0)
+    {
+     SpawnPointFP spawn
+     spawn.valid=true;spawn.origin=candidate;spawn.angles=Vector(0,yaw,0);spawn.node=GetNearestNodeToPos(point.GetOrigin())
+     DropTable drop
+     drop.nodes=nodes;drop.valid=true
+     entity ref=CreateScriptRef(candidate,spawn.angles)
+     file.runoffSpawns.append(spawn);file.runoffAnims.append(anim);file.runoffDrops.append(drop)
+     file.ziplineDropshipSpawns.append(ref)
+     {}
+     found=true;break
+    }
+    WaitFrame()
+   }
+   if(found)break
+  }
+  WaitFrame()
+ }
+ {}
+}
